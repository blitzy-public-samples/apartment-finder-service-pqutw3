# Docker build context exclusions.
# Effective when the build context is the repository root.
# backend/.dockerignore carries the same pattern set for a build whose
# context is the backend directory.

# Environment files
.env
.env.*
**/.env
**/.env.*

# Secrets directory
secrets/
**/secrets/

# Cloud service-account and credential files
google-credentials.json
**/google-credentials.json
*service-account*.json
**/*service-account*.json
*credentials*.json
**/*credentials*.json
gcp-*.json
**/gcp-*.json

# Generic credential directories and secret files
credentials/
**/credentials/
.secrets/
**/.secrets/
secrets.json
**/secrets.json
secret.json
**/secret.json
*.secrets.json
**/*.secrets.json

# Private keys, certificates, and keystores
*.pem
**/*.pem
*.key
**/*.key
*.p12
**/*.p12
*.pfx
**/*.pfx
*.jks
**/*.jks
*.keystore
**/*.keystore
*.crt
**/*.crt
*.der
**/*.der
*.ppk
**/*.ppk
*.p8
**/*.p8
*.pk8
**/*.pk8
id_rsa*
**/id_rsa*
id_ed25519*
**/id_ed25519*

# Machine credential files read by command-line tools
.netrc
**/.netrc
_netrc
**/_netrc
.pgpass
**/.pgpass
.htpasswd
**/.htpasswd

# Kubernetes cluster credentials
kubeconfig
**/kubeconfig
*.kubeconfig
**/*.kubeconfig

# Version-control metadata
.git
.git/**
**/.git
**/.git/**
.gitignore
**/.gitignore
.gitattributes
**/.gitattributes

# CI workflow definitions
.github/
**/.github/

# Container build definitions
.dockerignore
**/.dockerignore
**/Dockerfile*
**/docker-compose*.yml

# Python bytecode and packaging artefacts
**/__pycache__/
**/*.py[cod]
**/*$py.class
**/*.egg-info/
**/.eggs/

# Python virtual environments
venv/
.venv/
env/
ENV/
**/venv/
**/.venv/

# Test, type-check, and lint caches
**/.pytest_cache/
**/.pytest-basetemp/
**/.mypy_cache/
**/.ruff_cache/
**/.tox/

# Coverage output
**/.coverage
**/.coverage.*
**/coverage.xml
**/htmlcov/
**/coverage/

# Local and generated database files
*.db
**/*.db
*.db-journal
**/*.db-journal
*.db-shm
**/*.db-shm
*.db-wal
**/*.db-wal
*.sqlite
**/*.sqlite
*.sqlite3
**/*.sqlite3
apartment_finder_test
**/apartment_finder_test
apartment_finder_test.*
**/apartment_finder_test.*
test.db
**/test.db
test.sqlite
**/test.sqlite
test.sqlite3
**/test.sqlite3

# Node dependencies and build output
**/node_modules/
**/build/
**/dist/
**/npm-debug.log*
**/yarn-error.log*

# Terraform state, variable files and saved plans
**/.terraform/
**/.terraform.tfstate.lock.info
**/*.tfstate
**/*.tfstate.*
**/*.tfvars
**/*.tfvars.json
**/*.auto.tfvars
**/*.auto.tfvars.json
**/*.tfplan
**/*.tfplan.*
**/tfplan
**/tfplan.*
**/plan.out
**/plan.json
**/override.tf
**/override.tf.json
**/crash.log
**/crash.*.log

# Logs
**/*.log
**/logs/

# Editor and OS files
**/.DS_Store
**/Thumbs.db
**/.idea/
**/.vscode/
**/*.swp
**/*~

# Documentation and presentation assets
documentation/
**/documentation/
docs/
**/docs/
blitzy-deck/
**/blitzy-deck/
README.md
**/README.md
SECURITY.md
**/SECURITY.md

# Frontend application source
frontend/
**/frontend/

# Infrastructure definitions and operational scripts
infrastructure/
**/infrastructure/
scripts/
**/scripts/

# Test suites
tests/
**/tests/
