# Use an official Python runtime as a parent image
FROM python:3.9-slim

# Set the working directory in the container
# The application imports itself as backend.app.*, so the context lands in
# /app/backend and the process starts one directory above it
WORKDIR /app/backend

# Copy the requirements file into the container
COPY requirements.txt .

# Install any needed packages specified in requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copy the rest of the application code
COPY . .

# The import root backend.app.main resolves against
WORKDIR /app

# Make port 8000 available to the world outside this container
EXPOSE 8000

# Run the FastAPI server when the container launches
CMD ["uvicorn", "backend.app.main:app", "--host", "0.0.0.0", "--port", "8000"]
