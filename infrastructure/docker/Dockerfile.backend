# Use an official Python runtime as a parent image
FROM python:3.9-slim

# Set the working directory in the container
# The build context lands in /app/backend. DL-374
WORKDIR /app/backend

# Copy the requirements file into the container
COPY requirements.txt .

# Install any needed packages specified in requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copy the rest of the application code
COPY . .

# The directory the import root backend.app.main resolves against. DL-374
WORKDIR /app

# Make port 8000 available to the world outside this container
EXPOSE 8000

# Run the FastAPI server when the container launches.
# SEC-07: --no-proxy-headers keeps the login throttle keyed on the TCP peer.
# Without it uvicorn rewrites the peer from X-Forwarded-For whenever the
# connection arrives from a trusted address, which lets a caller choose its
# own throttle key (CWE-290, CWE-807). DL-433
CMD ["uvicorn", "backend.app.main:app", "--host", "0.0.0.0", "--port", "8000", "--no-proxy-headers"]
