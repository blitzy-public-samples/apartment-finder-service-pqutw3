FROM python:3.9-slim

WORKDIR /app

COPY requirements.txt .

RUN pip install --no-cache-dir -r requirements.txt

COPY . ./backend

# Create an unprivileged system group and user, then leave every path
# under /app owned by root with write permission removed for all
# principals, read granted to all, and execute granted on directories and
# on files that already carry it.
RUN groupadd --system --gid 1001 appgroup \
    && useradd --system --uid 1001 --gid appgroup --no-create-home --shell /usr/sbin/nologin appuser \
    && chown -R root:root /app \
    && chmod -R a-w,a+rX /app

USER appuser

EXPOSE 8000

# --no-proxy-headers leaves scope["client"] as the address the connection was
# actually made from, so TRUSTED_PROXY_HOPS is the only setting that decides
# which address a rate limit and a lockout are counted against.
CMD ["uvicorn", "backend.app.main:app", "--host", "0.0.0.0", "--port", "8000", "--no-proxy-headers"]