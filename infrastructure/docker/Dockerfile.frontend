# Use an official Node.js runtime as the base image
# Platform runtime policy: Node 20.x below 20.20.2 and 22.x below 22.12.0 are
# interdicted, so node:14 is not installable. 22 is the lowest permitted line
# and it builds react-scripts 5.0.1 without a legacy-OpenSSL workaround.
FROM node:22 as build

# Set the working directory in the container
WORKDIR /app

# Copy package.json and package-lock.json
COPY package.json package-lock.json ./

# Install dependencies
RUN npm ci

# Copy the rest of the application code
COPY . .

# Build the React app
RUN npm run build

# Use nginx to serve the React app
FROM nginx:alpine

# Copy the build output to replace the default nginx contents.
COPY --from=build /app/build /usr/share/nginx/html

# Expose port 80
EXPOSE 80

# Start nginx
CMD ["nginx", "-g", "daemon off;"]

# HUMAN ASSISTANCE NEEDED
# Please verify the following:
# 1. Ensure that the Node.js version (14) is appropriate for your project
# 2. Confirm that 'npm run build' is the correct command to build your React app
# 3. Check if any environment variables need to be set during the build process
# 4. Verify if any additional nginx configuration is required for your specific app