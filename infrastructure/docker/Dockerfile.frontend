# Use an official Node.js runtime as the base image
# Pinned Node line: 22, the lowest line the platform runtime policy
# permits. DL-375
FROM node:22 as build

# Set the working directory in the container
WORKDIR /app

# Copy the dependency manifest
# The install resolves from the manifest alone; no lock file is tracked.
# DL-375
COPY package.json ./

# Install dependencies
RUN npm install --no-audit --no-fund

# Copy the rest of the application code
COPY . .

# SEC-12: create-react-app embeds these into the bundle at build time.
# Both arrive as build arguments, never as literals, and neither may carry
# a secret. DL-375
ARG REACT_APP_API_BASE_URL
ARG REACT_APP_PAYPAL_CLIENT_ID
ENV REACT_APP_API_BASE_URL=$REACT_APP_API_BASE_URL
ENV REACT_APP_PAYPAL_CLIENT_ID=$REACT_APP_PAYPAL_CLIENT_ID

# Build the React app
RUN npm run build

# Use nginx to serve the React app
FROM nginx:alpine

# Copy the build output to replace the default nginx contents.
COPY --from=build /app/build /usr/share/nginx/html

# Expose port 80
EXPOSE 80

# Start nginx
CMD ["nginx", "-g", "daemon off;"]

# HUMAN ASSISTANCE NEEDED
# Please verify the following:
# 1. Confirm that 'npm run build' is the correct command to build your React app
# 2. Verify if any additional nginx configuration is required for your specific app