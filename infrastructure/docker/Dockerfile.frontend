# Use an official Node.js runtime as the base image
# Platform runtime policy: Node 20.x below 20.20.2 and 22.x below 22.12.0 are
# interdicted, so node:14 is not installable. 22 is the lowest permitted line
# and it builds react-scripts 5.0.1 without a legacy-OpenSSL workaround.
FROM node:22 as build

# Set the working directory in the container
WORKDIR /app

# Copy the dependency manifest
# No lock file is tracked, so the install resolves from the manifest alone;
# documentation/security/decision-log.md records that decision and the
# residual it carries
COPY package.json ./

# Install dependencies
RUN npm install --no-audit --no-fund

# Copy the rest of the application code
COPY . .

# SEC-12: create-react-app embeds these while the bundle builds, so a runtime
# value never reaches the browser. Both arrive as build arguments, never as
# literals, and neither may carry a secret
ARG REACT_APP_API_BASE_URL
ARG REACT_APP_PAYPAL_CLIENT_ID
ENV REACT_APP_API_BASE_URL=$REACT_APP_API_BASE_URL
ENV REACT_APP_PAYPAL_CLIENT_ID=$REACT_APP_PAYPAL_CLIENT_ID

# Build the React app
RUN npm run build

# Use nginx to serve the React app
FROM nginx:alpine

# Copy the build output to replace the default nginx contents.
COPY --from=build /app/build /usr/share/nginx/html

# Expose port 80
EXPOSE 80

# Start nginx
CMD ["nginx", "-g", "daemon off;"]

# HUMAN ASSISTANCE NEEDED
# Please verify the following:
# 1. Confirm that 'npm run build' is the correct command to build your React app
# 2. Verify if any additional nginx configuration is required for your specific app