# Environment files
.env
.env.tmp.*

# Credentials, certificates, and keys
secrets/
*.pem
*.key
*credentials*.json

# SEC-01, SEC-11: operator variable files carry the application role's
# password, and state records other resource attributes. The password
# itself reaches neither state nor a plan: main.tf takes it through the
# write-only password_wo argument from an ephemeral variable.
.terraform/
.terraform.tfstate.lock.info
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars
*.tfvars.json
!*.tfvars.example
crash.log
crash.*.log

# Build, cache, and coverage artifacts
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
coverage.xml
.venv/
node_modules/
/frontend/build/
/frontend/coverage/
