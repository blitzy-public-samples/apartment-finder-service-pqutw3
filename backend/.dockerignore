# Version control metadata
.git/

# Environment files
**/.env
**/.env.tmp.*

# Credentials, certificates, and keys
**/secrets/
**/*.pem
**/*.key
**/*credentials*.json

# Python caches and build artifacts
**/__pycache__/
**/*.py[cod]
**/*.egg-info/
**/.pytest_cache/
**/.coverage
**/coverage.xml
**/htmlcov/

# Local virtual environments
**/.venv/
**/venv/
