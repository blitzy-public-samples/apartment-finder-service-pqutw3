# This is a committed template and contains NO secrets. Every secret-bearing
# value below is a non-functional placeholder.
#
# Usage:
#   1. Copy this file to `.env` in the repository root.
#   2. Replace every CHANGE_ME_* and REPLACE_* placeholder with a value for
#      your environment.
#   3. `.env` is git-ignored and must never be committed.
#
# Format: one KEY=value per line, no `export` prefix, no spaces around `=`.
#
# This file uses the JSON array form with DOUBLE quotes throughout.
# The list-valued settings are ALLOWED_ORIGINS, ALLOWED_HOSTS, JWT_ALGORITHMS
# and PAYPAL_CERT_HOST_ALLOWLIST. Each accepts EITHER a JSON array with DOUBLE
# quotes, or a bare comma-separated list. These two lines are equivalent:
#   ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:80"]
#   ALLOWED_ORIGINS=http://localhost:3000,http://localhost:80
# A single-quoted array, a malformed array, and an empty entry produced by a
# doubled or trailing comma are all rejected at startup.
#
# Seven settings have no default and must be supplied: DATABASE_URL,
# SECRET_KEY, ZILLOW_API_KEY, PAYPAL_CLIENT_ID, PAYPAL_CLIENT_SECRET,
# PAYPAL_WEBHOOK_ID and SENDGRID_API_KEY. Each is marked `Required.` below.
# SENTRY_DSN is optional and may be left empty. The remaining 21 settings
# carry the defaults shown below, so a line may be omitted to accept its
# default.
#
# Configuration is validated when the application starts, and a rejected value
# stops startup rather than being defaulted or downgraded.
#
# PLACEHOLDER HANDLING. Every CHANGE_ME_* and REPLACE_* value below, and every
# value on a reserved example domain, is accepted ONLY while ENVIRONMENT=local.
# Set ENVIRONMENT to development, staging or production and startup fails until
# each of those values is replaced. SECRET_KEY is stricter still: its
# placeholder is rejected in every environment, including local.
#
# Setup instructions: README.md


# -----------------------------------------------------------------------------
# Runtime environment
# -----------------------------------------------------------------------------

# Deployment environment name.
# Accepted values: local, development, staging, production.
# `local` is the only value under which the placeholder values in this file,
# reserved example domains, and a sqlite DATABASE_URL are accepted.
# `production` additionally activates the payment-mode guard described under
# PAYPAL_MODE below.
ENVIRONMENT=local


# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------

# SQLAlchemy connection URL for the PostgreSQL database.
# Required. Secret-bearing in every real environment: the value embeds a
# database username and password, so supply it per environment and never
# commit it. Replace both placeholder segments below.
# The scheme must be postgresql:// or postgresql+psycopg2:// and the URL must
# carry both a host and a database name. sqlite:// is accepted only while
# ENVIRONMENT=local. The withdrawn postgres:// scheme is rejected.
DATABASE_URL=postgresql://REPLACE_DB_USER:REPLACE_DB_PASSWORD@localhost:5432/apartment_finder


# -----------------------------------------------------------------------------
# JWT / token signing
# -----------------------------------------------------------------------------

# SECRET: symmetric key used to sign and verify access tokens.
# Required. Minimum length 32 UTF-8 bytes, measured after surrounding
# whitespace is stripped. A value that is blank once stripped, carries leading
# or trailing whitespace, or matches a placeholder or well-known value is
# rejected at startup in EVERY environment, including local. The value shipped
# in this template is one of those, so a copied file will not start until you
# replace it.
# Generate one with either of:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#   openssl rand -base64 48
SECRET_KEY=CHANGE_ME_generate_a_real_key

# Allowlist of JWT algorithms accepted when signing and verifying tokens.
# Accepted values: HS256, HS384, HS512. Any other value is rejected at
# startup, and the value `none` is rejected in any letter case.
# JSON array of strings.
JWT_ALGORITHMS=["HS256"]

# Value written to, and required in, the `iss` claim of every access token.
JWT_ISSUER=apartment-finder-service

# Value written to, and required in, the `aud` claim of every access token.
JWT_AUDIENCE=apartment-finder-web

# Access token lifetime in minutes, counted from the time of issue.
ACCESS_TOKEN_EXPIRE_MINUTES=30


# -----------------------------------------------------------------------------
# Password hashing
# -----------------------------------------------------------------------------

# bcrypt cost factor applied when hashing a new password.
# Higher values cost more CPU per hash. Already-stored hashes carry their own
# cost factor and continue to verify regardless of this setting.
# Passwords are capped at 72 bytes, which is the maximum bcrypt accepts.
BCRYPT_ROUNDS=12


# -----------------------------------------------------------------------------
# HTTP surface, CORS and hosts
# -----------------------------------------------------------------------------

# Browser origins permitted to make cross-origin requests, sent back in the
# CORS response headers. Credentialed requests are allowed, so each origin
# must be listed in full including scheme and port.
# Each entry must be a complete <scheme>://<host>[:<port>] origin using http
# or https, carrying no wildcard, path, query string, fragment or user
# information. `null` and a bare host without a scheme are rejected. A request
# from an origin outside this list is not granted the CORS response headers.
# List or JSON array of strings.
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:80"]

# Host header values the application will serve.
# A request whose Host header is not listed here is rejected before routing,
# so a value that omits a hostname your clients actually use will reject
# legitimate traffic. List every hostname the service is reached by.
# Each entry must be a bare hostname or IP address with no scheme, port, path
# or user information. A wildcard entry, including "*", is rejected at startup.
# List or JSON array of strings.
ALLOWED_HOSTS=["localhost","127.0.0.1"]

# Maximum accepted request body size, in bytes. The default is 1048576 bytes
# (1 MiB). A larger body is rejected without being read into memory.
MAX_REQUEST_BODY_BYTES=1048576

# Maximum accepted limit for the listings endpoint; larger values are
# rejected.
MAX_PAGE_SIZE=100

# Rate limit for the login endpoint, as a `<count>/<period>` expression.
# Accepted periods include second, minute, hour and day, optionally preceded by
# a period multiple as in `5/2minutes`. The count must be between 1 and 10000
# and the period multiple between 1 and 1000, so `0/minute` is rejected.
# Several expressions may be joined with `;`, as in `3/minute;100/hour`.
RATE_LIMIT_LOGIN=5/minute

# Rate limit for the registration endpoint, same expression format as above.
RATE_LIMIT_REGISTER=3/minute


# -----------------------------------------------------------------------------
# Login lockout
# -----------------------------------------------------------------------------

# Number of consecutive failed login attempts that locks an account.
# Counted per account. Reaching this number starts the lockout period set by
# LOGIN_LOCKOUT_MINUTES below.
LOGIN_MAX_ATTEMPTS=5

# Duration in minutes that an account stays locked once the attempt limit is
# reached, after which the failure count resets.
LOGIN_LOCKOUT_MINUTES=15


# -----------------------------------------------------------------------------
# Zillow listing ingestion
# -----------------------------------------------------------------------------

# Endpoint the listing ingestion task queries. The value below is a
# placeholder on a reserved example domain, not a real endpoint; set it to the
# URL of the listing provider you are using.
# ZILLOW_API_KEY below is transmitted to this endpoint.
# The URL must use https in every environment, must address a named host
# carrying a top-level label, and must carry no user information
# (no `user:password@`), no query string and no fragment. A plaintext http
# URL, an IP literal, a single-label host, and any host addressing this
# machine, a private network or a cloud metadata service are rejected.
# The host must also be zillow.com, zillow-api.example.com, or a subdomain of
# either; any other destination is rejected at startup, and the ingestion task
# refuses to send the key to it even if the check is somehow bypassed. The
# example domain below is accepted only while ENVIRONMENT=local.
ZILLOW_API_URL=https://zillow-api.example.com/v2/listings

# SECRET: API key for the listing provider above.
# Required. Supply per environment and never commit it. The key is sent in a
# request header; it is not placed in the URL or in query parameters.
ZILLOW_API_KEY=CHANGE_ME_zillow_api_key

# Timeout in seconds applied to every outbound HTTP call the service makes,
# covering the listing provider, PayPal and email delivery. The email client
# is given this value explicitly. Accepted range is greater than 0 and up
# to 300.
HTTP_TIMEOUT_SECONDS=10


# -----------------------------------------------------------------------------
# PayPal integration
# -----------------------------------------------------------------------------

# PayPal environment the service transacts against.
# Accepted values: sandbox, live.
# Guard: the application refuses to start when ENVIRONMENT=production is
# paired with PAYPAL_MODE=sandbox.
PAYPAL_MODE=sandbox

# Base URL of the PayPal REST API. Exactly two values are accepted, and the
# value must correspond to PAYPAL_MODE in every environment:
#   PAYPAL_MODE=sandbox -> https://api-m.sandbox.paypal.com
#   PAYPAL_MODE=live    -> https://api-m.paypal.com
# Any other host, and any port, path, query string, fragment or embedded
# user information, is rejected at startup.
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# PayPal REST application client ID, issued in the PayPal developer console
# separately for sandbox and live. Required.
PAYPAL_CLIENT_ID=CHANGE_ME_paypal_client_id

# SECRET: client secret paired with PAYPAL_CLIENT_ID, used for the OAuth2
# client-credentials token exchange.
# Required. Supply per environment and never commit it.
PAYPAL_CLIENT_SECRET=CHANGE_ME_paypal_client_secret

# SECRET: identifier of the webhook subscription that receives payment
# notifications. Required. It is provisioned in the PayPal developer console
# and is one of the inputs to signature verification, so webhook notifications
# cannot be verified until this value is set.
PAYPAL_WEBHOOK_ID=CHANGE_ME_paypal_webhook_id

# Hosts permitted to serve the PayPal webhook signing certificate.
# The certificate URL arrives in the inbound PAYPAL-CERT-URL request header,
# and its host is checked against this list before the URL is used or
# forwarded; a host that is not listed causes the notification to be rejected.
# Only PayPal-owned hosts belong in this list. Each entry must be a bare
# lowercase hostname under paypal.com. List or JSON array of strings.
PAYPAL_CERT_HOST_ALLOWLIST=["api.paypal.com","api.sandbox.paypal.com","api-m.paypal.com","api-m.sandbox.paypal.com"]


# -----------------------------------------------------------------------------
# Email delivery
# -----------------------------------------------------------------------------

# SECRET: SendGrid API key used to send transactional email.
# Required. Supply per environment and never commit it.
SENDGRID_API_KEY=CHANGE_ME_sendgrid_api_key

# Sender address applied to outgoing email. The address below is on a reserved
# example domain; set it to an address on a domain verified with SendGrid.
# The value must be one <local-part>@<domain> address whose domain carries a
# top-level label. The example domain below is accepted only while
# ENVIRONMENT=local.
FROM_EMAIL=no-reply@example.com


# -----------------------------------------------------------------------------
# Secret management and observability
# -----------------------------------------------------------------------------

# Source the six secret-bearing settings are permitted to arrive from.
# Those settings are SECRET_KEY, DATABASE_URL, ZILLOW_API_KEY,
# PAYPAL_CLIENT_SECRET, PAYPAL_WEBHOOK_ID and SENDGRID_API_KEY, which are the
# same six values Terraform provisions as Secret Manager secrets.
# Accepted values:
#   env                 Any source is accepted, including this file.
#   gcp-secret-manager  Each of the six must be present and non-blank in the
#                       process environment; this file is not an accepted
#                       source for them and startup fails if one is missing.
#                       Use this where the deployment reads the values from
#                       Google Cloud Secret Manager and injects them as
#                       environment variables. The application does not call
#                       Secret Manager itself.
SECRET_BACKEND=env

# Sentry Data Source Name for error reporting.
# Optional, and the only setting here that may be left empty. An empty value
# disables error reporting and does not stop startup.
SENTRY_DSN=
