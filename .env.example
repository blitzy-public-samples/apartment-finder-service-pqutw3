# apartment-finder-service - backend environment variable template.
#
# Template only. Every value below is a placeholder, not a real credential.
# Copy this file to `.env` in the repository root, then fill in real values.
# `.gitignore` excludes `.env`. Never commit `.env`.
#
# Rationale for every setting and default: documentation/security/decision-log.md
# Provisioning, rotation and operational handling: SECURITY.md
#
# backend/app/core/config.py reads `.env` from the repository root and builds
# Settings() while importing. Eleven variables below are marked Required and
# have no default: the application refuses to start when one is missing.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# Required. SQLAlchemy connection URL for the application database role.
DATABASE_URL=postgresql://<db-user>:<db-password>@<db-host>:5432/<db-name>

# PostgreSQL sslmode for the application connection. Optional, defaults to require.
# Use disable for the Compose stack, whose `db` service is the Cloud SQL Auth
# Proxy listening on plain local TCP.
# require encrypts the connection but does not verify the server certificate.
# SECURITY.md covers the verify-full follow-on.
DB_SSLMODE=require

# ---------------------------------------------------------------------------
# Authentication and session
# ---------------------------------------------------------------------------

# Required. HMAC signing key, at least 32 characters. Generate a random value.
SECRET_KEY=<random-secret-min-32-chars>

# Required. Token signing algorithm. One of HS256, HS384, HS512, case-sensitive.
ALGORITHM=HS256

# Required. Access token lifetime in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Secure attribute on the session cookie. Optional, defaults to true.
# Set false only for local development over plain HTTP.
COOKIE_SECURE=true

# ---------------------------------------------------------------------------
# Cross-origin policy
# ---------------------------------------------------------------------------

# Required. JSON array of the exact origins allowed to send credentialed requests.
# A bare comma-separated list is not JSON and fails to parse.
# Every entry needs a scheme and host, lowercase, with no path and no trailing slash.
# An empty list, "*", "null", or a bare host is rejected, and the application
# will not start. Matching is exact, so no wildcard or prefix works.
# Local development adds the dev server origin, for example "http://localhost:3000".
ALLOWED_ORIGINS=["https://app.example.com"]

# ---------------------------------------------------------------------------
# Login throttle
# ---------------------------------------------------------------------------

# Failed login attempts allowed per window. Optional, defaults to 5.
LOGIN_RATE_LIMIT_ATTEMPTS=5

# Length of the throttle window in minutes. Optional, defaults to 15.
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15

# ---------------------------------------------------------------------------
# Zillow integration
# ---------------------------------------------------------------------------

# Required. Full URL of the Zillow listings endpoint.
ZILLOW_API_URL=https://<zillow-api-host>/<listings-endpoint-path>

# Required. Zillow API key.
ZILLOW_API_KEY=<zillow-api-key>

# ---------------------------------------------------------------------------
# PayPal
# ---------------------------------------------------------------------------

# PayPal environment. Optional, defaults to sandbox. Either sandbox or live.
PAYPAL_MODE=sandbox

# Required. PayPal REST client identifier.
PAYPAL_CLIENT_ID=<paypal-client-id>

# Required. PayPal REST client secret. Server-side only, never sent to a browser.
PAYPAL_CLIENT_SECRET=<paypal-client-secret>

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------

# Required. SendGrid API key.
SENDGRID_API_KEY=<sendgrid-api-key>

# Required. Verified sender address for outbound mail.
FROM_EMAIL=<no-reply@example.com>

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------

# Sentry ingest URL. Optional. Leave empty to keep error reporting off.
SENTRY_DSN=
