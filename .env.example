# apartment-finder-service - environment variable template.
#
# Two contracts live here. Everything down to the Observability section is
# the backend settings contract, read by the running process. The final
# section is the frontend build contract, read while the client bundle is
# compiled.
#
# Three kinds of value appear below, and the difference decides what an
# operator has to do with each line.
#
#   Placeholder. An angle-bracket token with no working value. Every one must
#   be replaced. All are secrets or environment-specific identifiers.
#
#   Default. A value identical to the one backend/app/core/config.py applies
#   when the variable is absent: DB_SSLMODE, COOKIE_SECURE, PAYPAL_MODE,
#   LOGIN_RATE_LIMIT_ATTEMPTS and LOGIN_RATE_LIMIT_WINDOW_MINUTES. The line
#   documents the default rather than changing anything.
#
#   Required choice. A variable with no default in code, whose shown value is a
#   working starting point rather than a default the application would supply:
#   ALGORITHM and ACCESS_TOKEN_EXPIRE_MINUTES. ALLOWED_ORIGINS is a required
#   choice too, and its shown origin is illustrative only: leaving it as
#   written blocks the frontend actually being served.
#
#   Deliberately empty. SENTRY_DSN alone, and the empty value is not the code
#   default. Absent, the setting is None; present and empty, it is the empty
#   string. Nothing reads it either way.
#
# No value below is real. .gitignore excludes .env. Never commit it.
#
# Format is checked only where a validator exists. ALGORITHM, PAYPAL_MODE,
# DB_SSLMODE and ALLOWED_ORIGINS are validated, and SECRET_KEY and the numeric
# settings carry bounds. Every other setting is accepted as an opaque string.
# DATABASE_URL, ZILLOW_API_URL, SENTRY_DSN and FROM_EMAIL are not
# format-checked at all: a malformed value starts the process and fails later,
# at first use, rather than at startup.
#
# Rationale for the security settings and their defaults, where one was
# recorded: documentation/security/decision-log.md
# Provisioning, rotation and operational handling: SECURITY.md
#
# The backend loads the file at startup. backend/app/core/config.py declares
# `env_file = ".env"` and backend/requirements.txt pins python-dotenv, the
# parser pydantic uses to read it. A variable already exported into the
# process environment, or injected by the deployment platform, overrides the
# value in the file.
#
# `env_file` is a filename with no directory, which pydantic resolves against
# the working directory of the process rather than the repository root. Pick
# one of two arrangements and stay with it: keep a single copy at the
# repository root and start every entry point from there, or supply the
# variables from the deployment platform and ship no file at all. Do not
# scatter copies to match each command's working directory. DL-372
#
# The pytest step in .github/workflows/ci.yml runs from `backend/` and needs
# no copy there. backend/tests/conftest.py assigns every value into the
# process environment before the first application import, and an exported
# variable takes precedence over the file.
#
# Settings() is constructed while config.py imports. Eleven variables below
# are marked Required and have no default: the application refuses to start
# when one is missing.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# Required. SQLAlchemy connection URL for the application database role.
DATABASE_URL=postgresql://<db-user>:<db-password>@<db-host>:5432/<db-name>

# PostgreSQL sslmode for the application connection. Optional, defaults to require.
# Use one lowercase value with no spaces: disable, allow, prefer, require,
# verify-ca, or verify-full. Any other value stops startup.
# Use disable for the Compose stack, whose `db` service is the Cloud SQL Auth
# Proxy listening on plain local TCP.
# require encrypts the connection but does not verify the server certificate.
# SECURITY.md covers the verify-full follow-on.
DB_SSLMODE=require

# ---------------------------------------------------------------------------
# Authentication and session
# ---------------------------------------------------------------------------

# Required. HMAC signing key. Generate a random value.
# Use at least 32 characters. The minimum UTF-8 byte length depends on
# ALGORITHM: 32 for HS256, 48 for HS384, and 64 for HS512 (RFC 7518 sec. 3.2).
# Startup stops below either floor.
SECRET_KEY=<random-secret-min-32-chars>

# Required. Token signing algorithm. One of HS256, HS384, HS512, case-sensitive.
# HS384 and HS512 raise the SECRET_KEY byte floor as documented above.
ALGORITHM=HS256

# Required. Access token lifetime in minutes. A whole number greater than 0;
# the application refuses to start on 0 or a negative value.
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Secure attribute on the session cookie. Optional, defaults to true.
# Set false only for local development over plain HTTP.
COOKIE_SECURE=true

# ---------------------------------------------------------------------------
# Cross-origin policy
# ---------------------------------------------------------------------------

# Required. JSON array of the exact origins allowed to send credentialed requests.
# A bare comma-separated list is not JSON and fails to parse.
# Each entry is a lowercase ASCII http or https origin: scheme, then a DNS name,
# an IPv4 literal or a bracketed IPv6 literal, then an optional port in 1-65535.
# Startup stops on an empty list, "*", "null", a bare host, userinfo, a path, a
# query, a fragment, a trailing slash, a scheme default port, or a bad host.
# Matching is exact. For local development, add "http://localhost:3000".
ALLOWED_ORIGINS=["https://app.example.com"]

# ---------------------------------------------------------------------------
# Login throttle
# ---------------------------------------------------------------------------

# Failed login attempts allowed per window. Optional, defaults to 5.
# At least 1; the application refuses to start on 0 or a negative value.
LOGIN_RATE_LIMIT_ATTEMPTS=5

# Throttle window in minutes. Optional; defaults to 15. Must be at least 1.
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15

# ---------------------------------------------------------------------------
# Zillow integration
# ---------------------------------------------------------------------------

# Required. Full URL of the Zillow listings endpoint. Accepted as an opaque
# string: the shape is not validated, so a malformed URL fails at the first
# outbound request rather than at startup.
ZILLOW_API_URL=https://<zillow-api-host>/<listings-endpoint-path>

# Required. Zillow API key.
ZILLOW_API_KEY=<zillow-api-key>

# ---------------------------------------------------------------------------
# PayPal
# ---------------------------------------------------------------------------

# PayPal environment. Optional, defaults to sandbox. Either sandbox or live.
PAYPAL_MODE=sandbox

# Required. PayPal REST client identifier.
PAYPAL_CLIENT_ID=<paypal-client-id>

# Required. PayPal REST client secret. Server-side only, never sent to a browser.
PAYPAL_CLIENT_SECRET=<paypal-client-secret>

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------

# Required. SendGrid API key.
SENDGRID_API_KEY=<sendgrid-api-key>

# Required. Sender address for outbound mail, which must be one the mail
# provider has already verified. Accepted as an opaque string: neither the
# address format nor its verification status is checked here, so a wrong value
# fails at the first send rather than at startup.
FROM_EMAIL=<no-reply@example.com>

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------

# Optional Sentry ingest URL. Not format-checked. Omitting the line leaves the
# setting as None; the empty assignment below leaves it as the empty string.
# Neither matters: the application does not initialize Sentry and nothing
# reads this value at runtime.
SENTRY_DSN=

# ---------------------------------------------------------------------------
# Frontend build variables - not backend settings
# ---------------------------------------------------------------------------
#
# create-react-app substitutes these into the client bundle while it builds.
# Pass them to the build: infrastructure/docker/Dockerfile.frontend declares
# one build argument per name, and infrastructure/docker/docker-compose.yml
# forwards both. DL-372
#
# Whatever these hold is served to every visitor. Never put a secret in one.

# Required by the browser client. Origin and path prefix of the API, with no
# trailing slash. frontend/src/services/api.ts reads it.
REACT_APP_API_BASE_URL=https://<api-host>

# Required by the browser client. The PayPal REST client identifier, which is
# public by design. frontend/src/index.tsx and frontend/src/services/paypal.ts
# read it. Its matching secret is the server-side setting above and must never
# be given to a build argument.
REACT_APP_PAYPAL_CLIENT_ID=<paypal-client-id>
