# Committed template. It carries NO secrets: every secret-bearing value below
# is a non-functional placeholder.
#
# Use. Run the setup script, which writes `.env` with mode 0600, generates a
# SECRET_KEY that clears every rule below and an ADMIN_SEED_PASSWORD, and
# prompts for the database password:
#
#   ./scripts/setup_dev_environment.sh
#
# Copying this file by hand is supported, but a hand-copied file does not
# start until SECRET_KEY is replaced. `.env` is git-ignored and must never be
# committed.
#
# Five values still need real provisioning from their provider before the
# integrations they configure work: ZILLOW_API_KEY, PAYPAL_CLIENT_ID,
# PAYPAL_CLIENT_SECRET, PAYPAL_WEBHOOK_ID and SENDGRID_API_KEY.
# PAYPAL_WEBHOOK_ID is provisioned in the PayPal console when the webhook is
# registered. Until then they hold the placeholders below, which are accepted
# only while ENVIRONMENT=local.
#
# Format: one KEY=value per line, no `export` prefix, no spaces around `=`.
# The list-valued settings -- ALLOWED_ORIGINS, ALLOWED_HOSTS, JWT_ALGORITHMS
# and PAYPAL_CERT_HOST_ALLOWLIST -- accept either a JSON array with DOUBLE
# quotes, the form used throughout this file, or a bare comma-separated list.
#
# 50 settings are documented below -- every setting the application declares.
# Seven have no default and must be supplied: DATABASE_URL, SECRET_KEY,
# ZILLOW_API_KEY, PAYPAL_CLIENT_ID, PAYPAL_CLIENT_SECRET, PAYPAL_WEBHOOK_ID
# and SENDGRID_API_KEY. Each is marked `Required.` below.
#
# Four of those carry a provider credential that the application registers
# for redaction from every log record: ZILLOW_API_KEY, PAYPAL_CLIENT_SECRET,
# PAYPAL_WEBHOOK_ID and SENDGRID_API_KEY. Each must be at least 8 characters
# long, which is the shortest value the redaction registry holds; a shorter
# value stops startup.
#
# One of the remaining 43 is a special case. ENVIRONMENT is the one setting
# whose value below is NOT its code default: the value shown is `local` and
# the code default is `development`, under which the placeholder values in
# this file are refused, so the ENVIRONMENT line must be kept in a copied
# file. It is marked `Keep this line.` below.
#
# The other 42 settings carry the defaults shown below, so a line may be
# omitted to accept its default.
#
# ENV_FILE names the file this content is read from and is NOT a setting, so
# it does not appear as a line below. It is read from the process environment
# only, and it has three states:
#   * absent  -> the application reads DEFAULT_ENV_FILE, which is `.env`
#                at the repository root, by absolute path, next to this file.
#                The path is computed from the location of
#                backend/app/core/config.py, so the same file is read
#                whichever directory the process was started in.
#   * a path  -> that file is read instead, and the value is used exactly as
#                given, so a RELATIVE value is still resolved against the
#                process working directory.
#   * empty   -> no file is read at all and every setting must come from the
#                process environment.
# Do not add an ENV_FILE line to a copied file: an empty one would stop that
# same file from being read.
#
# Configuration is validated when the application starts, and a rejected value
# stops startup rather than being defaulted or downgraded.
#
# PLACEHOLDER HANDLING. Every CHANGE_ME_* and REPLACE_* value below, and every
# value on a reserved example domain, is accepted ONLY while ENVIRONMENT=local.
# Set ENVIRONMENT to development, staging or production and startup fails until
# each of those values is replaced. SECRET_KEY is stricter still: its
# placeholder is rejected in every environment, including local.
#
# Setup instructions: README.md


# -----------------------------------------------------------------------------
# Runtime environment
# -----------------------------------------------------------------------------

# Deployment environment name.
# Accepted values: local, development, staging, production.
# `local` is the only value under which the placeholder values in this file,
# reserved example domains, and a sqlite DATABASE_URL are accepted.
# `production` additionally activates the payment-mode guard described under
# PAYPAL_MODE below.
# Keep this line. The code default is `development`, not the `local` shown
# here, so omitting the line leaves ENVIRONMENT=development, under which the
# plaintext http PAYPAL_RETURN_URL and PAYPAL_CANCEL_URL defaults below are
# refused and the application does not start.
ENVIRONMENT=local


# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------

# SQLAlchemy connection URL for the PostgreSQL database.
# Required. Secret-bearing in every real environment: the value embeds a
# database username and password, so supply it per environment and never
# commit it. Replace the placeholder password segment below.
# The scheme must be postgresql:// or postgresql+psycopg2:// and the URL must
# carry both a host and a database name. sqlite:// is accepted only while
# ENVIRONMENT=local. The withdrawn postgres:// scheme is rejected.
# For local development, scripts/setup_dev_environment.sh creates the role
# `apartment_finder` and the database `apartment_finder` named below, prompts
# for the password, and rewrites this entry in the generated .env with that
# password percent-encoded. Keep the role and database names here in step with
# that script: they are one contract.
DATABASE_URL=postgresql://apartment_finder:REPLACE_DB_PASSWORD@localhost:5432/apartment_finder

# Seconds the libpq handshake may take before the attempt is abandoned.
# Optional; the default is shown, and the accepted range is 1 to 300. Passed to
# the driver as connect_timeout, so an unreachable or unresponsive database
# fails the request instead of holding a worker open indefinitely. Applied to a
# postgresql:// URL only; a sqlite:// URL opens a local file and takes no
# handshake.
DB_CONNECT_TIMEOUT_SECONDS=3

# Seconds the server may spend on any single statement before it is cancelled.
# Optional; the default is shown, and the accepted range is 1 to 300. Carried
# into the libpq options parameter as statement_timeout, so a statement that
# runs past it is cancelled by the server rather than held by the caller.
# Applied to a postgresql:// URL only. It is below HTTP_TIMEOUT_SECONDS, so a
# statement contending with a request that is waiting on a provider call is
# cancelled before that call returns: the webhook route reads the delivery
# identifier back and attempts its write again, so a repeated delivery is still
# answered as a duplicate and an unresolved one is answered for redelivery.
# The migrations do not use this bound; DB_MIGRATION_STATEMENT_TIMEOUT_SECONDS
# below is theirs.
DB_STATEMENT_TIMEOUT_SECONDS=3

# Seconds the server may spend on any single schema statement before it is
# cancelled. Optional; the default is shown, and the accepted range is 1 to
# 3600. Carried into the libpq options parameter as statement_timeout by
# backend/migrations/env.py, so it bounds the statements a revision runs and
# nothing on the request path. A revision rewrites whatever the tables already
# hold, so its budget is minutes where a request-path read is held to seconds;
# the activeDeadlineSeconds of the migration job remains the outer bound on the
# run as a whole. Applied to a postgresql:// URL only.
DB_MIGRATION_STATEMENT_TIMEOUT_SECONDS=600

# Seconds an established socket may hold unacknowledged data before it is
# aborted. Optional; the default is shown, and the accepted range is 1 to 300.
# Passed to the driver as tcp_user_timeout in milliseconds, so a caller holding
# a pooled connection to a server that has stopped answering does not wait on
# the socket indefinitely. Applied to a postgresql:// URL only.
DB_TCP_USER_TIMEOUT_SECONDS=4

# Seconds a request may wait for a free pooled connection.
# Optional; the default is shown, and the accepted range is above 0 and up to
# 300. Once the pool is saturated a further request is refused after this wait
# rather than queueing without bound. Applied to a postgresql:// URL only.
DB_POOL_TIMEOUT_SECONDS=10.0

# Seconds after which a pooled connection is discarded and reopened.
# Optional; the default is shown, and the accepted range is 60 to 86400. Keeps
# a connection from outliving an idle timeout imposed by the server, a
# connection pooler or a load balancer. A liveness check on checkout is enabled
# alongside it, so a connection closed underneath the pool is replaced rather
# than handed to a request handler. Applied to a postgresql:// URL only.
DB_POOL_RECYCLE_SECONDS=1800


# -----------------------------------------------------------------------------
# JWT / token signing
# -----------------------------------------------------------------------------

# SECRET: symmetric key used to sign and verify access tokens.
# Required. Every rule below is enforced at startup in EVERY environment,
# including local, and each is measured after surrounding whitespace is
# stripped. Leading or trailing whitespace is itself rejected.
#   * Minimum length, in UTF-8 bytes, set by the strongest algorithm named in
#     JWT_ALGORITHMS, because RFC 7518 section 3.2 requires an HMAC key to be
#     at least as long as the hash output:
#         HS256 -> 32 bytes   HS384 -> 48 bytes   HS512 -> 64 bytes
#     A configuration naming several algorithms takes the largest of these.
#   * At least 12 distinct characters.
#   * No character repeated more than 3 times in a row (`aaaa` is rejected).
#   * No run of more than 4 consecutive code points, ascending or descending
#     (`abcde` and `54321` are both rejected).
#   * Not a placeholder or well-known value. The value shipped in this
#     template is one of those, so a copied file will not start until you
#     replace it.
# scripts/setup_dev_environment.sh generates one that clears every rule
# above, writes it straight into a .env created with mode 0600, and renders
# it nowhere. Prefer it.
# To generate one by hand, write it into the target file rather than to the
# terminal. A key printed to standard output is captured by the shell
# history, by the terminal scrollback and by any session recording, and a
# key that has been displayed must be treated as already disclosed. Both
# forms below produce 64 bytes, which clears the length floor for all three
# algorithms; if a generated value is ever refused for one of the variety
# rules above, generate another:
#   ( umask 077; printf 'SECRET_KEY=%s\n' \
#       "$(python -c 'import secrets; print(secrets.token_urlsafe(48))')" \
#       >> .env )
#   ( umask 077; printf 'SECRET_KEY=%s\n' "$(openssl rand -base64 48)" \
#       >> .env )
SECRET_KEY=CHANGE_ME_generate_a_real_key

# Allowlist of JWT algorithms accepted when signing and verifying tokens.
# Accepted values: HS256, HS384, HS512. Any other value is rejected at
# startup, and the value `none` is rejected in any letter case. The first
# entry is the algorithm every token is signed with; every entry is accepted
# on verification. Naming HS384 or HS512 raises the SECRET_KEY length floor
# documented above.
# JSON array of strings.
JWT_ALGORITHMS=["HS256"]

# Value written to, and required in, the `iss` claim of every access token.
JWT_ISSUER=apartment-finder-service

# Value written to, and required in, the `aud` claim of every access token.
JWT_AUDIENCE=apartment-finder-web

# Access token lifetime in minutes, counted from the time of issue.
ACCESS_TOKEN_EXPIRE_MINUTES=30


# -----------------------------------------------------------------------------
# Password hashing
# -----------------------------------------------------------------------------

# bcrypt cost factor applied when hashing a new password.
# Higher values cost more CPU per hash. Already-stored hashes carry their own
# cost factor and continue to verify regardless of this setting.
# Passwords are capped at 72 bytes, which is the maximum bcrypt accepts.
BCRYPT_ROUNDS=12


# -----------------------------------------------------------------------------
# HTTP surface, CORS and hosts
# -----------------------------------------------------------------------------

# Browser origins permitted to make cross-origin requests, sent back in the
# CORS response headers. Credentialed requests are allowed, so each origin
# must be listed in full including scheme and port.
# Each entry must be a complete <scheme>://<host>[:<port>] origin using http
# or https, carrying no wildcard, path, query string, fragment or user
# information. `null` and a bare host without a scheme are rejected. A request
# from an origin outside this list is not granted the CORS response headers.
# The local defaults cover the frontend dev server (3000) and the frontend
# container (80). List or JSON array of strings.
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:80"]

# Host header values the application will serve.
# A request whose Host header is not listed here is rejected before routing,
# so a value that omits a hostname your clients actually use will reject
# legitimate traffic. List every hostname the service is reached by.
# Each entry must be a bare hostname or IP address with no scheme, port, path
# or user information. A wildcard entry, including "*", is rejected at startup.
# List or JSON array of strings.
ALLOWED_HOSTS=["localhost","127.0.0.1"]

# Maximum accepted request body size, in bytes. The default is 1048576 bytes
# (1 MiB). A larger body is rejected without being read into memory.
MAX_REQUEST_BODY_BYTES=1048576

# Maximum number of body chunks accepted from one request. A body that
# declares no Content-Length, as a chunked body does, is read chunk by chunk;
# this caps how many chunks are accepted, bounding the work a body of many
# tiny chunks can start inside the size cap above.
MAX_REQUEST_BODY_CHUNKS=2048

# Maximum accepted limit for the listings and filters collections; a larger
# limit is rejected, and a request naming no limit is served the smaller of 100
# and this value.
MAX_PAGE_SIZE=100

# Maximum accepted row offset for the listings and filters collections. A
# request naming a larger `skip` is rejected by request validation, so the rows
# the database walks for one request stay bounded by this value plus
# MAX_PAGE_SIZE above. Accepted range is 0 to 1000000. The listings collection
# is readable without a credential, so this also bounds the work one anonymous
# request can ask for.
MAX_PAGINATION_OFFSET=10000

# Rate limit for the login endpoint, as a `<count>/<period>` expression.
# Accepted periods include second, minute, hour and day, optionally preceded by
# a period multiple as in `5/2minutes`. The count must be between 1 and 10000
# and the period multiple between 1 and 1000, so `0/minute` is rejected.
# Several expressions may be joined with `;`, as in `3/minute;100/hour`.
#
# A refused login is padded out to a fixed duration so that the
# unknown-account branch and the wrong-password branch take the same time,
# and the login handler is synchronous, so each refusal occupies one server
# worker thread for that duration rather than yielding it. This count is
# therefore also the bound on how many workers one client address can hold
# at once through refusals: raising it raises that number too. Row 96.8.2 of
# docs/security/DECISION_LOG.md records the measurement and the trade-off.
RATE_LIMIT_LOGIN=5/minute

# Rate limit for the registration endpoint, same expression format as above.
RATE_LIMIT_REGISTER=3/minute

# Rate limit for the PayPal webhook endpoint, same expression format as above.
# The endpoint is reachable without a credential, so this bounds how much work
# an unauthenticated caller can ask the service to do. Set it above the
# delivery rate PayPal is configured to send, or genuine notifications will be
# refused and retried.
RATE_LIMIT_WEBHOOK=60/minute

# Rate limit for the readiness endpoint, same expression format as above.
# The endpoint is reachable without a credential, so this bounds how often an
# unauthenticated caller can ask for the report. Set it above the rate your
# orchestrator and container probes poll at, or a genuine probe will be refused
# and the workload reported unready.
RATE_LIMIT_READINESS=60/minute

# Rate-limit storage URI. Local runs may use bounded-memory://; non-local
# environments require a supported shared backend.
RATE_LIMIT_STORAGE_URI=bounded-memory://

# Capacity of the container stack's `cache` service, as a redis memory size.
# Optional; defaults to 128mb. Read only by
# infrastructure/docker/docker-compose.yml, never by the application.
# Once the store reaches this size, keys are evicted by least recent use, so a
# rate-limit key set that grows without bound cannot fill it: a key is one
# remote address on one route within one window.
CACHE_MAXMEMORY=128mb

# Number of rate-limit keys the bounded-memory store tracks at once. A key is
# one remote address on one route within one window. Once a hit carries the
# count past this number, keys whose windows have closed are dropped and the
# keys closest to closing are evicted. Accepted range is 64 to 1048576.
# Ignored by every other scheme.
RATE_LIMIT_MAX_TRACKED_KEYS=4096

# Number of proxies of your own a request passes through before it reaches the
# application. Optional; the default is shown, and the accepted range is 0 to
# 10. It decides which address a rate-limited request is counted against.
#   0  The X-Forwarded-For header is not read and the peer address of the
#      connection is used. Correct when clients connect to the application
#      directly, and the safe default: a caller cannot influence its own key.
#   1  One proxy of yours terminates the connection -- an ingress controller, a
#      Cloud Load Balancer or a reverse proxy. The address is taken one entry
#      from the right-hand end of the chain, which is the entry that proxy
#      wrote and the last one no caller could set.
#   n  n such proxies in sequence; the address is taken n entries from the end.
# Set this to the real number. Setting it too low counts every caller behind
# your own proxy under one key, so one abusive caller exhausts the limit for
# all of them. Setting it too high reads an entry the caller supplied, so a
# caller takes a fresh key per request and the limit stops applying. A chain
# shorter than the count, or a selected entry that is not an IP address, falls
# back to the peer address.
TRUSTED_PROXY_HOPS=0


# -----------------------------------------------------------------------------
# Readiness probe bounds
# -----------------------------------------------------------------------------

# Seconds one readiness outcome is reused for before the database is read
# again. A probe arriving inside this window is answered from the recorded
# outcome and opens no connection, so a burst costs one read rather than one
# read each. Keep it below your probe interval, or a probe reads a stale
# outcome. Accepted range is above 0 and up to 300.
READINESS_CACHE_SECONDS=5.0

# Seconds the readiness probe's own database read may take. Applied as a
# transaction-local statement and lock timeout on PostgreSQL, so it bounds that
# one read and nothing else -- neither another route nor the migrations inherit
# it. Accepted range is above 0 and up to 60.
READINESS_TIMEOUT_SECONDS=2.0


# -----------------------------------------------------------------------------
# Login lockout
# -----------------------------------------------------------------------------

# Number of consecutive failed login attempts that locks an account.
# Counted per account. Reaching this number starts the lockout period set by
# LOGIN_LOCKOUT_MINUTES below.
LOGIN_MAX_ATTEMPTS=5

# Duration in minutes that an account stays locked once the attempt limit is
# reached, after which the failure count resets.
LOGIN_LOCKOUT_MINUTES=15


# -----------------------------------------------------------------------------
# Zillow listing ingestion
# -----------------------------------------------------------------------------

# Endpoint the listing ingestion task queries. The value below is a
# placeholder on a reserved example domain, not a real endpoint; set it to the
# URL of the listing provider you are using.
# ZILLOW_API_KEY below is transmitted to this endpoint.
# Validated at startup: the URL must use https in every environment, must
# address a named host carrying a top-level label, and must carry no user
# information (no `user:password@`), no query string and no fragment. A
# plaintext http URL, an IP literal, a single-label host, and any host
# addressing this machine, a private network or a cloud metadata service are
# rejected. The host must also be zillow.com, zillow-api.example.com, or a
# subdomain of either; any other destination is rejected at startup, and the
# ingestion task also re-checks the host before it sends the key. The example
# domain below is accepted only while ENVIRONMENT=local.
ZILLOW_API_URL=https://zillow-api.example.com/v2/listings

# SECRET: API key for the listing provider above.
# Required. Supply per environment and never commit it. The key is sent in a
# request header; it is not placed in the URL or in query parameters.
ZILLOW_API_KEY=CHANGE_ME_zillow_api_key

# Timeout in seconds applied to every outbound HTTP call the service makes,
# covering the listing provider, PayPal and email delivery. The email client is
# given this value explicitly rather than relying on its own default.
# Accepted range is greater than 0 and up to 300. It is above
# DB_STATEMENT_TIMEOUT_SECONDS, so a database statement contending with a
# request that is waiting on one of these calls is ended by the server first;
# the webhook route re-reads the delivery identifier and attempts its write
# again when that happens.
HTTP_TIMEOUT_SECONDS=10

# Largest number of distinct postal codes one ingestion pass reads from saved
# filters. The pass covers that many and records once when it reaches the
# number, so the work a pass does does not grow with the number of saved
# filters. Accepted range is 1 to 100000.
INGESTION_MAX_ZIP_CODES=1000

# Largest number of postal codes one request to the listing provider carries.
# The postal codes read under INGESTION_MAX_ZIP_CODES above are split into
# requests of this size, and the provider client refuses a larger list without
# issuing a request. Accepted range is 1 to 1000.
INGESTION_ZIP_CODE_CHUNK=50


# -----------------------------------------------------------------------------
# PayPal integration
# -----------------------------------------------------------------------------

# PayPal environment the service transacts against.
# Accepted values: sandbox, live.
# Guard: the application refuses to start when ENVIRONMENT=production is
# paired with PAYPAL_MODE=sandbox.
PAYPAL_MODE=sandbox

# Base URL of the PayPal REST API. Exactly two values are accepted, and the
# value must correspond to PAYPAL_MODE in every environment:
#   PAYPAL_MODE=sandbox -> https://api-m.sandbox.paypal.com
#   PAYPAL_MODE=live    -> https://api-m.paypal.com
# Any other host, and any port, path, query string, fragment or embedded
# user information, is rejected at startup.
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# PayPal REST application client ID, issued in the PayPal developer console
# separately for sandbox and live. Required.
PAYPAL_CLIENT_ID=CHANGE_ME_paypal_client_id

# SECRET: client secret paired with PAYPAL_CLIENT_ID, used for the OAuth2
# client-credentials token exchange.
# Required. Supply per environment and never commit it.
PAYPAL_CLIENT_SECRET=CHANGE_ME_paypal_client_secret

# SECRET: identifier of the webhook subscription that receives payment
# notifications. Required. It is provisioned in the PayPal developer console
# and is one of the inputs to signature verification, so webhook notifications
# cannot be verified until this value is set.
PAYPAL_WEBHOOK_ID=CHANGE_ME_paypal_webhook_id

# Hosts permitted to serve the PayPal webhook signing certificate.
# The certificate URL arrives in the inbound PAYPAL-CERT-URL request header,
# and its host is checked against this list before the URL is used or
# forwarded; a host that is not listed causes the notification to be rejected.
# Only PayPal-owned hosts belong in this list. Each entry must be a bare
# lowercase hostname under paypal.com. List or JSON array of strings.
PAYPAL_CERT_HOST_ALLOWLIST=["api.paypal.com","api.sandbox.paypal.com","api-m.paypal.com","api-m.sandbox.paypal.com"]

# Maximum number of simultaneous connections the service opens to the PayPal
# REST API. This bounds the outbound work any burst of inbound requests,
# including unauthenticated webhook deliveries, can start.
PAYPAL_MAX_CONNECTIONS=20

# Addresses PayPal returns the payer to once the hosted checkout ends. These are
# browser destinations in your own frontend, not API endpoints, and they are the
# only source of the targets handed to PayPal. Neither is derived from
# ALLOWED_ORIGINS or from the other.
# PAYPAL_RETURN_URL receives a payer who approved the order; PAYPAL_CANCEL_URL
# receives one who abandoned the checkout. They are separate settings and each is
# validated on its own.
# Both defaults address the single /subscription page the frontend router
# declares, served by the development server on port 3000. The query string is
# the only difference between them: a page that ignores it still renders, and
# one that reads it tells the two outcomes apart.
# The docker compose stack publishes the frontend on port 80 and reads its own
# COMPOSE_PAYPAL_RETURN_URL and COMPOSE_PAYPAL_CANCEL_URL entries, documented
# in the Docker Compose section below. The two entries here reach a container
# stack through neither name.
# Validated at startup, for each of the two: one complete
# <scheme>://<host>[:<port>][/<path>][?<query>] address using http or https,
# carrying no wildcard, fragment or user information. A trailing slash is
# removed. Outside ENVIRONMENT=local the scheme must be https and the host must
# not address this machine or a private network, which refuses the plaintext
# localhost defaults below. PAYPAL_CANCEL_URL must also differ from
# PAYPAL_RETURN_URL.
PAYPAL_RETURN_URL=http://localhost:3000/subscription?paypal=return
PAYPAL_CANCEL_URL=http://localhost:3000/subscription?paypal=cancel


# -----------------------------------------------------------------------------
# Email delivery
# -----------------------------------------------------------------------------

# SECRET: SendGrid API key used to send transactional email.
# Required. Supply per environment and never commit it.
SENDGRID_API_KEY=CHANGE_ME_sendgrid_api_key

# Sender address applied to outgoing email. The address below is on a reserved
# example domain; set it to an address on a domain verified with SendGrid.
# The value must be one <local-part>@<domain> address whose domain carries a
# top-level label. The example domain below is accepted only while
# ENVIRONMENT=local.
FROM_EMAIL=no-reply@example.com


# -----------------------------------------------------------------------------
# Secret management and observability
# -----------------------------------------------------------------------------

# Source the six secret-bearing settings are permitted to arrive from.
# Those settings are SECRET_KEY, DATABASE_URL, ZILLOW_API_KEY,
# PAYPAL_CLIENT_SECRET, PAYPAL_WEBHOOK_ID and SENDGRID_API_KEY, which are the
# same six values Terraform provisions as Secret Manager secrets.
# Accepted values:
#   env                 Any source is accepted, including this file. Accepted
#                       only while ENVIRONMENT is `local`.
#   gcp-secret-manager  Each of the six must be present and non-blank in the
#                       process environment; this file is not an accepted
#                       source for them and startup fails if one is missing.
#                       Use this where the deployment reads the values from
#                       Google Cloud Secret Manager and injects them as
#                       environment variables. The application does not call
#                       Secret Manager itself.
# Required outside a local environment: any ENVIRONMENT other than `local` must
# name gcp-secret-manager here, and startup fails naming both values when it
# does not.
SECRET_BACKEND=env

# Threshold every structured record is filtered at.
# Accepted values: CRITICAL, ERROR, WARNING, INFO, DEBUG. A numeric level or a
# misspelling is refused. DEBUG is accepted only while ENVIRONMENT is local,
# because at that level a failure record carries the rendered traceback.
# The threshold applies to this application's own records. The records of the
# outbound HTTP client, the migration runner and the SQL statement logger are
# held at their own thresholds, which this setting cannot lower.
LOG_LEVEL=INFO

# Telemetry endpoint for error reporting.
# Optional, and read by no code path in this service: nothing in the
# application sends events to it, so setting it activates no reporting here.
# It is declared and documented so the name stays reserved and a deployment
# that supplies it is not rejected at startup. Leave it empty.
SENTRY_DSN=


# -----------------------------------------------------------------------------
# Docker Compose
# -----------------------------------------------------------------------------
#
# Docker Compose-only values; see infrastructure/docker/docker-compose.yml
# and README.md for profiles and usage.
#
# A dollar sign inside a value read by docker compose is doubled: write
# `$$` for each literal dollar sign, so a password of `abc$def` is written
# `abc$$def` here. The rule applies to a value filled in here by hand. It
# never applies to the entries scripts/setup_dev_environment.sh writes:
# that script refuses a database password carrying a dollar sign, a
# backslash, a quotation mark or a backtick, so the entries it writes
# need no escaping.
#
# RENDERING IS NOT STARTING. The SECRET_KEY shipped here is a placeholder
# that startup refuses in every environment, including local, so nothing
# comes up until it is replaced -- or until
# scripts/setup_dev_environment.sh is run, which writes one.

# SQLAlchemy connection URL the containers reach the database by.
# Required by docker compose, with no default. This is a second URL, distinct
# from the DATABASE_URL documented above: that one names localhost, for a
# process running on the host, and this one names the compose service `db`,
# which is the name both database options answer to. Secret-bearing, for the
# same reason DATABASE_URL is. scripts/setup_dev_environment.sh writes both
# entries from the one password it prompts for.
COMPOSE_DATABASE_URL=postgresql://apartment_finder:REPLACE_DB_PASSWORD@db:5432/apartment_finder

# Credentials and names the local PostgreSQL service starts with.
# POSTGRES_PASSWORD has no default and is required on every compose invocation,
# including under the `gcp` profile where the local service does not start; the
# other two default to the values shown. Keep POSTGRES_PASSWORD in step with
# the password segment of COMPOSE_DATABASE_URL above, and the other two in step
# with its role and database segments. POSTGRES_PASSWORD carries the password
# literally and the two URLs carry it percent-encoded, so the value appears in
# both forms.
POSTGRES_PASSWORD=REPLACE_DB_PASSWORD
POSTGRES_USER=apartment_finder
POSTGRES_DB=apartment_finder

# Cloud SQL instance the proxy connects to, as project:region:instance.
# Read only under the `gcp` profile, where it is required: compose defaults
# it to a marker carrying no colon and the proxy exits naming it. The proxy
# authenticates with the ambient credentials of its host and selects the
# instance's private address.
CLOUD_SQL_INSTANCE_CONNECTION_NAME=CHANGE_ME_project:region:instance

# Base URL the browser reaches the backend at.
# Optional; the compose default is the address the published backend port
# answers on, shown below. The value is passed to the frontend image as the
# REACT_APP_API_BASE_URL build argument at image build time, which
# infrastructure/docker/Dockerfile.frontend declares as an ARG and exports
# before it builds, so the built bundle carries it. The PayPal client id
# documented above reaches the bundle the same way, under the build argument
# REACT_APP_PAYPAL_CLIENT_ID. Both are inlined into the bundle at build time
# and are read by the browser, so neither may carry a secret.
REACT_APP_API_BASE_URL=http://localhost:8000

# Environment name and host lists the containers run with.
# BACKEND_ENVIRONMENT is required by docker compose, with no default, and
# sets ENVIRONMENT inside the containers. The two host lists are optional
# and the compose defaults are shown. A non-local BACKEND_ENVIRONMENT
# additionally requires SECRET_BACKEND, RATE_LIMIT_STORAGE_URI,
# PAYPAL_RETURN_URL, PAYPAL_CANCEL_URL and ZILLOW_API_URL to carry
# non-local values, and `production` requires PAYPAL_MODE=live with the
# PAYPAL_API_BASE that matches it.
BACKEND_ENVIRONMENT=local
BACKEND_ALLOWED_ORIGINS=http://localhost,http://localhost:80
BACKEND_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# PayPal redirect URLs the containers run with.
# Optional, and read from these two compose-side names rather than from the
# PAYPAL_RETURN_URL and PAYPAL_CANCEL_URL entries documented above. Those two
# address a frontend served by the development server on port 3000; the compose
# stack publishes the frontend on port 80, and docker compose loads this file
# automatically, so a single pair of names cannot serve both. The compose
# defaults are the two values below and they apply whenever these names are
# absent. Each is validated exactly as its PAYPAL_* counterpart is: one
# complete http or https address with no wildcard, fragment or user
# information, the two must differ, and outside BACKEND_ENVIRONMENT=local the
# scheme must be https and the host must not address this machine or a private
# network.
COMPOSE_PAYPAL_RETURN_URL=http://localhost/subscription?paypal=return
COMPOSE_PAYPAL_CANCEL_URL=http://localhost/subscription?paypal=cancel

# Administrator seed account
# -----------------------------------------------------------------------------
# Neither entry below is a setting the application reads. They are read only
# while the database is being prepared.

# Address of the single administrator account.
# Migration 0002 promotes this address and no other, so this entry documents
# it and must match it.
ADMIN_SEED_EMAIL=test@blitzy.com

# Password stored for that address when the account is first created.
# Secret-bearing. It must satisfy the registration password policy: at least
# 12 characters, at most 72 UTF-8 bytes, and at least one uppercase letter,
# one lowercase letter, one digit and one special character. An account
# already stored is left as it is; to apply a change, run:
#   ADMIN_SEED_PASSWORD=... python -m backend.app.core.admin_provisioning
# Generate the value into this file rather than onto a terminal:
#   ( umask 077; grep -v '^ADMIN_SEED_PASSWORD=' .env > .env.new; mv .env.new .env
#     python -c "import secrets, string; a = string.ascii_letters + string.digits + '!@#^&*()-_=+'; print('ADMIN_SEED_PASSWORD=' + ''.join(secrets.choice(a) for _ in range(24)))" >> .env )
ADMIN_SEED_PASSWORD=CHANGE_ME_generate_a_real_password

# Whether the provisioning step above may replace a password already in place.
# Not secret-bearing. Left false, the step gives the migration-created account
# its first password and otherwise leaves a stored password alone, so running
# it repeatedly changes nothing. Set it to true only for the duration of a
# deliberate rotation, and return it to false afterwards: while it is true,
# every run replaces the administrator's password with ADMIN_SEED_PASSWORD.
# The ordered procedure is in docs/security/CREDENTIAL_ROTATION.md section 3.5.
ADMIN_CREDENTIAL_RESET=false
